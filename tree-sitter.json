{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "moon",
      "camelcase": "moon",
      "scope": "source.moon",
      "path": ".",
      "file-types": [
        "mn"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.3.6",
    "license": "MIT",
    "description": "moon grammar for tree-sitter",
    "authors": [
      {
        "name": "moon contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/moonlang-dev/moon-releases"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
